# ─── Required ──────────────────────────────────────────────────────────────

# Session signing secret. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Optional separate at-rest encryption key for stored provider/OAuth
# credentials. If unset, falls back to BETTER_AUTH_SECRET — convenient, but a
# session-cookie leak then also decrypts every stored provider credential.
# Generate with: openssl rand -hex 32
# MANIFEST_ENCRYPTION_KEY=


# ─── Network binding ────────────────────────────────────────────────────────
# The live deploy binds the LAN interface so the app is reachable across the
# network. Change APP_HOST to 127.0.0.1 to lock to localhost only.
APP_HOST=100.84.145.125

# Host (published) port users connect to. Defaults to 62400 (live value).
APP_PORT=62400

# Internal container listener port. FIXED at 2099 (image default) — do NOT
# change. The mapping APP_PORT -> PORT happens in docker-compose.yml.
PORT=2099

# Public base URL users actually hit. Used for OAuth callbacks + auth links.
# Usually http://${APP_HOST}:${APP_PORT}. Override for a domain (https://...).
BETTER_AUTH_URL=http://100.84.145.125:62400


# ─── Database (EXTERNAL Postgres) ───────────────────────────────────────────
# This instance does NOT run a bundled Postgres. Point DATABASE_URL at your
# standalone Postgres (live deploy uses MnfstService@100.84.145.125:62727/Mnfst).
# Special characters in the password must be percent-encoded
# (e.g. `@` → `%40`, `:` → `%3A`, `/` → `%2F`).
DATABASE_URL=postgresql://MnfstService:CHANGE_ME@100.84.145.125:62727/Mnfst


# ─── TLS / telemetry ────────────────────────────────────────────────────────
# Live deploy sits behind a TLS terminator, so the app must not emit HSTS.
MANIFEST_DISABLE_HSTS=1

# Anonymous usage telemetry. Set to 0 to enable; 1 disables.
MANIFEST_TELEMETRY_DISABLED=1


# ─── Auto-fix (v6.18.0+, self-hosted) ──────────────────────────────────────
# Hosted repair of failing LLM requests. OFF by default; opt in per-agent in
# the dashboard after one-time consent. false = no calls to the healer service.
AUTOFIX_GLOBAL_ENABLED=false


# ─── Local LLM host (optional) ──────────────────────────────────────────────
# Reaches an OpenAI-compatible server on the Docker host (Ollama/LM Studio).
OLLAMA_HOST=http://host.docker.internal:11434


# ─── Email provider (optional) ──────────────────────────────────────────────
# Unified config — used for BOTH login emails AND threshold alert notifications.
# Set ONE provider block. Without it: signup verification is waived, password
# reset no-ops, threshold alerts still work if configured per-user in dashboard.

# Option A: Resend
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=re_your_api_key_here
# EMAIL_FROM=noreply@yourdomain.com

# Option B: Mailgun
# EMAIL_PROVIDER=mailgun
# EMAIL_API_KEY=key-your_api_key_here
# EMAIL_DOMAIN=mg.yourdomain.com
# EMAIL_FROM=noreply@mg.yourdomain.com

# Option C: SendGrid
# EMAIL_PROVIDER=sendgrid
# EMAIL_API_KEY=SG.your_key
# EMAIL_FROM=noreply@yourdomain.com


# ─── OAuth logins (optional) ────────────────────────────────────────────────
# Each provider activates automatically when both CLIENT_ID and CLIENT_SECRET
# are set. Callback URL: ${BETTER_AUTH_URL}/api/auth/callback/<provider>

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
